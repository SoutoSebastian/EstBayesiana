N <- 400
# 1. Generar Datos
Z_horas <- runif(N, min = 1, max = 12)  # Horas en la PC
# X: Aumento en lentes
X_aumento <- pmax(0, 0.3 * Z_horas + rnorm(N, mean = 0, sd = 0.5))
# Y: Habilidad para programar (1 a 5)
Y_habilidad <- 1 + 0.4 * Z_horas + rnorm(N, mean = 0, sd = 0.4)
Y_habilidad <- pmax(1, pmin(5, Y_habilidad)) # Acotar entre 1 y 5
# Crear Dataframe
datos_lentes <- data.frame(
Horas_PC  = Z_horas,
Aumento   = X_aumento,
Habilidad = Y_habilidad,
Grupo_Horas = factor(ntile(Z_horas, 3), labels = c("Pocas Hs PC", "Medias Hs PC", "Muchas Hs PC"))
)
# Modelo 1: Ingenuo (Sin ajustar por Horas en PC)
fit_ingenuo <- lm(Habilidad ~ Aumento, data = datos_lentes)
cat("=== 1. REGRESIÓN INGENUA (Sin ajustar por Z) ===\n")
print(summary(fit_ingenuo)$coefficients)
# Muestra una asociación positiva espuria entre Aumento y Habilidad.
# Modelo 2: Ajustado por Horas en PC (Z)
fit_ajustado <- lm(Habilidad ~ Aumento + Horas_PC, data = datos_lentes)
cat("\n=== 2. REGRESIÓN AJUSTADA (Condicionando por Z) ===\n")
print(summary(fit_ajustado)$coefficients)
# El efecto de 'Aumento' pasa a ser ~0 y no significativo (X e Y son independientes dado Z).
# ==============================================================================
# 3. Gráfico de Dispersión (Scatter Plot)
# ==============================================================================
ggplot(datos_lentes, aes(x = Aumento, y = Habilidad)) +
geom_point(aes(color = Grupo_Horas), alpha = 0.6, size = 2) +
# Regresión ingenua global (Línea punteada negra)
geom_smooth(method = "lm", color = "black", linetype = "dashed", se = FALSE, linewidth = 1) +
# Regresión condicional por estrato de Horas (Líneas de color)
geom_smooth(aes(color = Grupo_Horas), method = "lm", se = FALSE, linewidth = 1.2) +
scale_y_continuous(limits = c(1, 5), breaks = 1:5) +
scale_color_manual(values = c("Pocas Hs PC" = "#2b5c8f", "Medias Hs PC" = "#e67e22", "Muchas Hs PC" = "#e74c3c")) +
labs(
title = "Ejemplo de Tenedor (Fork): Aumento de Lentes vs Habilidad para Programar",
subtitle = "Línea punteada negra: Asociación Espuria | Líneas de color: Independencia Condicional dado Z",
x = "Aumento en los Lentes (X)",
y = "Habilidad para Programar 1-5 (Y)",
color = "Horas en la PC (Z)"
) +
theme_minimal(base_size = 12) +
theme(plot.title = element_text(face = "bold"))
# Y: Habilidad para programar (1 a 5)
Y_habilidad <- 1 + 0.35 * Z_horas + rnorm(N, mean = 0, sd = 0.4)
