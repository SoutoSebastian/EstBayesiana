install.packages("rstanarm")
library(rstanarm)
rstanarm(radon)
radon
data <- radon
View(data)
library(dplyr)
county_summary <- radon %>%
group_by(county) %>%
summarise(
n = n(),
mean_radon = mean(log_radon),
.groups = "drop"
)
head(county_summary)
library(ggplot2)
ggplot(county_summary, aes(x = n, y = mean_radon)) +
geom_point() +
labs(
x = "Número de mediciones",
y = "Promedio de log_radon"
) +
theme_minimal()
m1 <- lm(log_radon ~ county - 1, data = radon)
m2 <- lm(log_radon ~ county - 1 + floor, data = radon)
anova(m1, m2)
summary(m2)
install.packages("lme4")
library(lme4)
m3 <- lmer(log_radon ~ (1 | county), data = radon)
library(rstanarm)
library(dplyr)
library(ggplot2)
library(lme4)
data <- radon
county_summary <- radon %>%
group_by(county) %>%
summarise(
n = n(),
mean_radon = mean(log_radon),
.groups = "drop"
)
head(county_summary)
ggplot(county_summary, aes(x = n, y = mean_radon)) +
geom_point() +
labs(
x = "Número de mediciones",
y = "Promedio de log_radon"
) +
theme_minimal()
m1 <- lm(log_radon ~ county - 1, data = radon)
m2 <- lm(log_radon ~ county - 1 + floor, data = radon)
anova(m1, m2)
summary(m2)
m3 <- lmer(log_radon ~ (1 | county), data = radon)
summary(m3)
vc <- VarCorr(m3)
tau2 <- attr(vc$county, "stddev")^2
sigma2 <- attr(vc, "sc")^2
tau2 / (tau2 + sigma2)
ranef(m3)
m4 <- lmer(log_radon ~ floor + (1 | county), data = radon)
vc <- as.data.frame(VarCorr(m4))
tau2 <- vc$vcov[1]
sigma2 <- vc$vcov[2]
ICC <- tau2 / (tau2 + sigma2)
ICC
summary(m4)
library(rstanarm)
library(dplyr)
library(ggplot2)
library(lme4)
data <- radon
county_summary <- radon %>%
group_by(county) %>%
summarise(
n = n(),
mean_radon = mean(log_radon),
.groups = "drop"
)
head(county_summary)
ggplot(county_summary, aes(x = n, y = mean_radon)) +
geom_point() +
labs(
x = "Número de mediciones",
y = "Promedio de log_radon"
) +
theme_minimal()
m1 <- lm(log_radon ~ county - 1, data = radon)
m2 <- lm(log_radon ~ county - 1 + floor, data = radon)
anova(m1, m2)
summary(m2)
m3 <- lmer(log_radon ~ (1 | county), data = radon)
summary(m3)
vc <- VarCorr(m3)
tau2 <- attr(vc$county, "stddev")^2
sigma2 <- attr(vc, "sc")^2
tau2 / (tau2 + sigma2)
ranef(m3)
m4 <- lmer(log_radon ~ floor + (1 | county), data = radon)
vc <- as.data.frame(VarCorr(m4))
tau2 <- vc$vcov[1]
sigma2 <- vc$vcov[2]
ICC <- tau2 / (tau2 + sigma2)
ICC
summary(m4)
m5 <- lmer(log_radon ~ floor + (1 + floor | county), data = radon)
m5 <- lmer(log_radon ~ floor + (1 + floor | county), data = radon)
summary(m5)
m6 <- lmer(log_radon ~ floor + log_uranium + (1 + floor | county),
data = radon)
summary(m6)
anova(m3, m4, m5, m6)
plot_data <- data.frame(
county = names(fixed_intercepts),
fixed = fixed_intercepts,
mixed = mixed_intercepts
)
m1 <- lm(log_radon ~ county - 1, data = radon)
fixed_intercepts <- coef(m1)
m3 <- lmer(log_radon ~ (1 | county), data = radon)
global <- fixef(m3)[1]
random <- ranef(m3)$county[,1]
mixed_intercepts <- global + random
plot_data <- data.frame(
county = names(fixed_intercepts),
fixed = fixed_intercepts,
mixed = mixed_intercepts
)
plot_data <- left_join(plot_data, county_summary, by = "county")
ggplot(plot_data,
aes(x = fixed,
y = mixed,
size = n)) +
geom_point(alpha = 0.7) +
geom_abline(slope = 1,
intercept = 0,
linetype = "dashed") +
labs(
x = "Intercepto sin pooling",
y = "Intercepto con partial pooling",
size = "N° mediciones"
) +
theme_minimal()
View(plot_data)
View(county_summary)
plot_data <- data.frame(
county = sub("^county", "", names(fixed_intercepts)),
fixed = fixed_intercepts,
mixed = mixed_intercepts
)
plot_data <- left_join(plot_data, county_summary, by = "county")
ggplot(plot_data,
aes(x = fixed,
y = mixed,
size = n)) +
geom_point(alpha = 0.7) +
geom_abline(slope = 1,
intercept = 0,
linetype = "dashed") +
labs(
x = "Intercepto sin pooling",
y = "Intercepto con partial pooling",
size = "N° mediciones"
) +
theme_minimal()
predict(m4,
newdata = nuevo,
allow.new.levels = TRUE)
