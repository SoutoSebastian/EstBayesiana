tasa_verdadera <- refugio %>%
group_by(breed_main) %>%
summarise(
n = n(),
adoptados = sum(desenlace == "Adopcion")
) %>%
filter(n >= 100) %>%
mutate(
tasa_verdadera = adoptados / n
) %>%
arrange(desc(n))
head(verdad)
head(tasa_verdadera)
set.seed(123)
muestra <- refugio %>%
filter(breed_main %in% verdad$breed_main) %>%
group_by(breed_main) %>%
slice_sample(n = 15)
set.seed(123)
muestra <- refugio %>%
filter(breed_main %in% tasa_verdadera$breed_main) %>%
group_by(breed_main) %>%
slice_sample(n = 15)
tasa_cruda <- muestra %>%
group_by(breed_main) %>%
summarise(
adopciones = sum(desenlace == "Adopcion"),
tasa_cruda = adopciones / 15
)
comparacion <- verdad %>%
select(breed_main, tasa_verdadera) %>%
left_join(tasa_cruda, by = "breed_main")
comparacion <- tasa_verdadera %>%
select(breed_main, tasa_verdadera) %>%
left_join(tasa_cruda, by = "breed_main")
head(comparacion)
ggplot(comparacion,
aes(x = tasa_verdadera,
y = tasa_cruda)) +
geom_point() +
geom_abline(slope = 1,
intercept = 0,
color = "red")
